# Every environment variable this app reads, with NO real values. Commit this file.
# Copy it to .env (git-ignored) and fill in real values locally; in production the platform sets them.
GITHUB_TOKEN=            # read-only token with repo, read:org, read:user; GH_TOKEN works too
GH_TOKEN=                # alternative to GITHUB_TOKEN; `gh auth token` is the fallback
IMPACT_REVIEW_HOST=      # default github.com; Enterprise Server host or SUB.ghe.com
IMPACT_REVIEW_RUNS=      # default ~/impact-review-runs; where run folders go
DD_API_KEY=              # speedup: Datadog API key
DD_APP_KEY=              # speedup: Datadog application key, read scopes (timeseries_query; RUM read for RUM journeys)
DD_SITE=                 # speedup: default datadoghq.com; us3/us5/ap1/ap2.datadoghq.com, datadoghq.eu, ddog-gov.com
PROMETHEUS_URL=          # speedup: https Prometheus base URL (plain http only on localhost)
PROMETHEUS_TOKEN=        # speedup: optional bearer token for Prometheus
SPEEDUP_RUNS=       # speedup: default ~/speedup-runs; data folders go here
SPEEDUP_CONFIG=     # speedup: default perf/speedup.json
