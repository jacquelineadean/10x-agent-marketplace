# GroundWork standard editor settings (STANDARD.md §5i).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,mjs,cjs,json,yml,yaml,css,html,vue,svelte}]
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab
