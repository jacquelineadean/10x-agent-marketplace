# Every environment variable this app reads, with NO real values. Commit this file.
# Copy it to .env (git-ignored) and fill in real values locally; in production the platform sets them.
GITHUB_TOKEN=            # read-only token with repo, read:org, read:user; GH_TOKEN works too
GH_TOKEN=                # alternative to GITHUB_TOKEN; `gh auth token` is the fallback
IMPACT_REVIEW_HOST=      # default github.com; Enterprise Server host or SUB.ghe.com
IMPACT_REVIEW_RUNS=      # default ~/impact-review-runs; where run folders go
DD_API_KEY=              # perf-ratchet: Datadog API key
DD_APP_KEY=              # perf-ratchet: Datadog application key, read scopes (timeseries_query; RUM read for RUM journeys)
DD_SITE=                 # perf-ratchet: default datadoghq.com; us3/us5/ap1/ap2.datadoghq.com, datadoghq.eu, ddog-gov.com
PROMETHEUS_URL=          # perf-ratchet: https Prometheus base URL (plain http only on localhost)
PROMETHEUS_TOKEN=        # perf-ratchet: optional bearer token for Prometheus
PERF_RATCHET_RUNS=       # perf-ratchet: default ~/perf-ratchet-runs; data folders go here
PERF_RATCHET_CONFIG=     # perf-ratchet: default perf/ratchet.json
