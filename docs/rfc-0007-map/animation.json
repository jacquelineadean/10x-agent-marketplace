  "steps": [
    {
      "caption": "chronicle takes painted, illustrated requests and briefing takes data requests; both plugins link the same engine folder.",
      "pulse": [
        "engine"
      ]
    },
    {
      "caption": "A creative request: the story skill draws in SVG, the painter washes it in watercolor, and the engine renders the page.",
      "show": [
        "painter",
        "page"
      ],
      "flow": [
        "creative"
      ]
    },
    {
      "caption": "A data request: read-only collectors query company systems and write facts, and Claude reads only the digest.",
      "show": [
        "collectors",
        "sys",
        "run",
        "brand"
      ],
      "flow": [
        "data"
      ]
    },
    {
      "caption": "Without keys, the gatherer subagent reads MCP connectors; raw output stays inside it and only facts come back.",
      "show": [
        "gatherer",
        "mcp"
      ],
      "flow": [
        "mcplane"
      ]
    },
    {
      "caption": "Refresh replays the saved queries with no model call, then the engine rebuilds the page and the slide exports.",
      "show": [
        "exports"
      ],
      "flow": [
        "refresh"
      ]
    },
    {
      "caption": "The dashed line is still open: chronicle could borrow briefing's gatherer for company facts, with no dependency between plugins.",
      "draw": [
