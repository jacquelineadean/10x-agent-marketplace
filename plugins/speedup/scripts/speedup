#!/bin/sh
# Runs the speedup command line from wherever the plugin is installed.
# Standard library only: uv picks a Python 3.11+ without touching the user's environment.
here="$(cd "$(dirname "$0")/.." && pwd)"
export PYTHONPATH="$here/src${PYTHONPATH:+:$PYTHONPATH}"
if command -v uv >/dev/null 2>&1; then
  exec uv run --quiet --no-project --python ">=3.11" python -m speedup "$@"
fi
exec python3 -m speedup "$@"
