  "migration": {"system": "datadog", "lane": "mcp", "connection": "datadog", "query": "sum:trace.http.request.hits{platform:keystone} by month as share of all requests", "window": {"start": "2025-07-01", "end": "2026-09-30"}, "as_of": "2026-10-14"},
  "reliability": {"system": "datadog", "lane": "mcp", "connection": "datadog", "query": "SLO history, 30-day availability by month; incidents by severity", "window": {"start": "2025-09-01", "end": "2026-09-30"}, "as_of": "2026-10-14"},
  "plan": {"system": "jira", "lane": "mcp", "connection": "claude_ai_Atlassian", "query": "JQL project = KEY AND sprint in closedSprints() ORDER BY sprint", "window": {"start": "2025-03-03", "end": "2026-10-14"}, "as_of": "2026-10-14"},
