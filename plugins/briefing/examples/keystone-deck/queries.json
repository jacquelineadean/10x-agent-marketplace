  "experience": {"system": "datadog", "lane": "mcp", "connection": "datadog", "query": "p95:trace.http.request.duration{service:checkout}.rollup(avg, 2592000)", "window": {"start": "2025-03-01", "end": "2026-09-30"}, "as_of": "2026-10-14"},
